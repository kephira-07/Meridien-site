# Liste d'attente — choisissez UNE des deux options, puis copiez ce fichier
# en `.env.local` (jamais versionné) et renseignez les valeurs.

# Option 1 — Resend (https://resend.com) : ajout à une audience
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# Option 2 — Webhook générique (Zapier, Make, Brevo, votre API…)
# Reçoit un POST JSON : { "email": "...", "source": "site-meridien", "date": "..." }
WAITLIST_WEBHOOK_URL=
